# ===== Superposition: peptide only, all centroids aligned =====
open D:/Researching/Peptide\ epitope/md\ results/salt_bridge/clean/representative_f783_clean.pdb
open D:/Researching/Peptide\ epitope/md\ results/salt_bridge/clean/centroid_0_f378_clean.pdb
open D:/Researching/Peptide\ epitope/md\ results/salt_bridge/clean/centroid_1_f503_clean.pdb
open D:/Researching/Peptide\ epitope/md\ results/salt_bridge/clean/centroid_2_f924_clean.pdb
open D:/Researching/Peptide\ epitope/md\ results/salt_bridge/clean/centroid_3_f100_clean.pdb
open D:/Researching/Peptide\ epitope/md\ results/salt_bridge/clean/centroid_4_f156_clean.pdb

matchmaker #2/A:1-275 #1/A:1-275
matchmaker #3/A:1-275 #1/A:1-275
matchmaker #4/A:1-275 #1/A:1-275
matchmaker #5/A:1-275 #1/A:1-275
matchmaker #6/A:1-275 #1/A:1-275

hide #1-6/A,B target a; hide #1-6/C target a
show #1-6/C target a; style #1-6/C stick
color #1/C #7f7f7f target c  # representative = grey
color #2/C #e74c3c target c  # centroid 0
color #3/C #3498db target c  # centroid 1
color #4/C #2ecc71 target c  # centroid 2 (main)
color #5/C #f39c12 target c  # centroid 3
color #6/C #9b59b6 target c  # centroid 4

# Label K2 positions
label #1/C:2 text "K2"; label #2/C:2 text "K2"
label #3/C:2 text "K2"; label #4/C:2 text "K2"
label #5/C:2 text "K2"; label #6/C:2 text "K2"
label #1/C:1-9 text "{residue.name}{residue.number}"

view #1/C:1-9
turn y -30; turn x -10

lighting soft; lighting shadows true; set bgColor white

save D:/Researching/Peptide\ epitope/md\ pic/structural_superposition.png width 2400 height 1800 dpi 300 transparency false supersample 3
save D:/Researching/Peptide\ epitope/md\ pic/structural_superposition.pdf width 2400 height 1800 dpi 300 transparency false supersample 3

close all
exit
